# Frontend build and runtime configuration for Docker Compose.
# Copy to .env at the repository root and fill in your Stack Auth project values.
# For local Next.js development, use frontend/.env.local.example instead.
# Public values are build arguments; the private key is a BuildKit secret at build time.
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=
